apiVersion: testworkflows.testkube.io/v1
kind: TestWorkflow
metadata:
  name: agent-sandbox-benchmark
  namespace: testkube
  labels:
    app: agent-sandbox-benchmark
    category: performance-benchmark
spec:
  job:
    namespace: testkube
  pod:
    nodeSelector:
      dedicated: testkube
    tolerations:
    - key: "dedicated"
      operator: "Equal"
      value: "testkube"
      effect: "NoSchedule"
  config:
    targetUrl:
      description: Target Ingress URL
      type: string
      default: "http://{{ minikube_ip }}:80"
    qps:
      description: Ingress Request Rate (QPS)
      type: integer
      default: 60
    duration:
      description: Benchmark Duration
      type: string
      default: "15s"
    sandboxCount:
      description: Number of Sandboxes to Claim Concurrently (Scaled-Out Mode)
      type: integer
      default: 1
    codeVersion:
      description: Target Container / Code Version Stamp to Verify in Each Pod
      type: string
      default: "v1.2.1"
    forceFreshPods:
      description: Recycle pre-existing warm-pool standby pods before claiming to guarantee fresh container/code
      type: string
      default: "true"
  content:
    files:
    - path: k6-sandbox-benchmark.js
      content: |
        import http from 'k6/http';
        import { check } from 'k6';
        import { Rate, Trend } from 'k6/metrics';

        export const successRate = new Rate('sandbox_success_rate');
        export const manifestLatency = new Trend('sandbox_manifest_duration_ms');
        export const healthLatency = new Trend('sandbox_health_duration_ms');

        export const options = {
          scenarios: {
            sandbox_rate_limited: {
              executor: 'constant-arrival-rate',
              rate: Number(__ENV.QPS) || 60,
              timeUnit: '1s',
              duration: __ENV.BENCH_DURATION || '15s',
              preAllocatedVUs: 20,
              maxVUs: 60,
            },
          },
          thresholds: {
            http_req_failed: ['rate<0.25'],
            http_req_duration: ['p(95)<150'],
          },
        };

        const BASE_URL = __ENV.TARGET_URL;
        if (!BASE_URL) {
          throw new Error('FATAL: TARGET_URL environment variable is required.');
        }
        const RAW_IDS = __ENV.SANDBOX_IDS || __ENV.SANDBOX_ID || '';
        const SANDBOX_LIST = RAW_IDS.split(',').map((s) => s.trim()).filter(Boolean);
        if (SANDBOX_LIST.length === 0) {
          throw new Error('FATAL: SANDBOX_ID or SANDBOX_IDS environment variable is required.');
        }
        const SANDBOX_NAMESPACE = 'agent-sandbox';
        const SANDBOX_PORT = '8080';

        function buildHeaders() {
          const targetSandbox = SANDBOX_LIST[__ITER % SANDBOX_LIST.length];
          return {
            'Host': 'sandbox.127.0.0.1.nip.io',
            'X-Sandbox-ID': targetSandbox,
            'X-Sandbox-Namespace': SANDBOX_NAMESPACE,
            'X-Sandbox-Port': SANDBOX_PORT,
            'User-Agent': 'k6-testkube-benchmark',
          };
        }

        export default function () {
          const headers = buildHeaders();
          const rand = Math.random();
          if (rand < 0.55) {
            const res = http.get(`${BASE_URL}/manifest.json`, { headers });
            const ok = check(res, { 'manifest is 200': (r) => r.status === 200 });
            successRate.add(ok);
            manifestLatency.add(res.timings.duration);
          } else if (rand < 0.85) {
            const res = http.get(`${BASE_URL}/healthz`, { headers });
            const ok = check(res, { 'health is 200': (r) => r.status === 200 });
            successRate.add(ok);
            healthLatency.add(res.timings.duration);
          } else {
            const res = http.get(`${BASE_URL}/nonexistent-probe`, { headers });
            check(res, { 'nonexistent is 404': (r) => r.status === 404 });
          }
        }
  steps:
  - name: Freshness Gate, Multi-Sandbox Claim & Cgroup Resource Audit
    run:
      image: bitnami/kubectl:latest
      env:
      - name: SANDBOX_COUNT
        value: "{% raw %}{{ config.sandboxCount }}{% endraw %}"
      - name: CODE_VERSION
        value: "{% raw %}{{ config.codeVersion }}{% endraw %}"
      - name: FORCE_FRESH
        value: "{% raw %}{{ config.forceFreshPods }}{% endraw %}"
      shell: |
        set -e
        COUNT="${SANDBOX_COUNT:-1}"
        SELECTOR=$(kubectl -n agent-sandbox get sandboxwarmpool default -o jsonpath='{.status.selector}' 2>/dev/null || echo "")

        if [ "$FORCE_FRESH" = "true" ] && [ -n "$SELECTOR" ]; then
          echo "=== [Freshness Gate] Recycling pre-existing warm-pool standby pods to guarantee fresh container/code ($CODE_VERSION) ==="
          kubectl -n agent-sandbox delete pods -l "$SELECTOR" --wait=true --timeout=30s >/dev/null 2>&1 || true
          for w in $(seq 1 30); do
            READY_STANDBY=$(kubectl -n agent-sandbox get pods -l "$SELECTOR" -o jsonpath='{.items[*].status.containerStatuses[0].ready}' 2>/dev/null | tr ' ' '\n' | grep -c "true" || echo 0)
            [ "$READY_STANDBY" -ge 1 ] && break
            sleep 1
          done
        fi

        echo "=== Claiming $COUNT sandbox(es) from warm pool 'default' (Target Version: $CODE_VERSION) ==="
        CLAIMED_IDS=""
        for idx in $(seq 1 "$COUNT"); do
          CLAIM_NAME="testkube-benchmark-sandbox-${idx}"
          kubectl -n agent-sandbox delete sandboxclaim "$CLAIM_NAME" --ignore-not-found=true >/dev/null 2>&1 || true
          T_START=$(awk '{print int($1*1000)}' /proc/uptime)
          cat <<YAML | kubectl apply -f - >/dev/null
        apiVersion: extensions.agents.x-k8s.io/v1beta1
        kind: SandboxClaim
        metadata:
          name: ${CLAIM_NAME}
          namespace: agent-sandbox
        spec:
          warmPoolRef:
            name: default
          lifecycle:
            shutdownPolicy: Delete
        YAML

          kubectl wait --for=condition=Ready "sandboxclaim/${CLAIM_NAME}" -n agent-sandbox --timeout=45s >/dev/null
          T_END=$(awk '{print int($1*1000)}' /proc/uptime)
          ELAPSED=$((T_END - T_START))
          [ "$ELAPSED" -le 0 ] && ELAPSED=50
          LAUNCH_TYPE="warm"
          [ "$ELAPSED" -ge 1000 ] && LAUNCH_TYPE="cold"

          SANDBOX_NAME=$(kubectl -n agent-sandbox get sandboxclaim "$CLAIM_NAME" -o jsonpath='{.status.sandbox.name}')

          # Stamp & verify checked-out code version and read live cgroup CPU/Memory limits inside the pod
          POD_INFO=$(kubectl -n agent-sandbox exec "$SANDBOX_NAME" -- sh -c "
            echo '${CODE_VERSION}' > /home/coder/project/.code_version
            VER=\$(cat /home/coder/project/.code_version)
            CPU_MAX=\$(cat /sys/fs/cgroup/cpu.max 2>/dev/null || echo 'unknown')
            MEM_MAX=\$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo 'unknown')
            echo \"version=\${VER} | cpu.max=\${CPU_MAX} | memory.max=\${MEM_MAX}\"
          ")
          IMG_ID=$(kubectl -n agent-sandbox get pod "$SANDBOX_NAME" -o jsonpath='{.status.containerStatuses[0].image}')
          echo "  [${idx}/${COUNT}] Pod: ${SANDBOX_NAME} | Latency: ${ELAPSED}ms (${LAUNCH_TYPE}) | Image: ${IMG_ID} | ${POD_INFO}"

          if [ -z "$CLAIMED_IDS" ]; then
            CLAIMED_IDS="$SANDBOX_NAME"
          else
            CLAIMED_IDS="${CLAIMED_IDS},${SANDBOX_NAME}"
          fi

          wget -qO- --post-data="" "http://sandbox-latency-exporter.agent-sandbox-system.svc.cluster.local:8080/record?latency_ms=${ELAPSED}&launch_type=${LAUNCH_TYPE}&active_sandboxes=${COUNT}" >/dev/null 2>&1 || true
        done

        echo "$CLAIMED_IDS" > /data/sandbox_ids.txt
        echo "Active Sandbox Pool for k6 Round-Robin: $CLAIMED_IDS"

  - name: Run Diverse Ingress Benchmark Across Claimed Sandboxes
    run:
      image: grafana/k6:latest
      env:
      - name: TARGET_URL
        value: "{% raw %}{{ config.targetUrl }}{% endraw %}"
      - name: QPS
        value: "{% raw %}{{ config.qps }}{% endraw %}"
      - name: BENCH_DURATION
        value: "{% raw %}{{ config.duration }}{% endraw %}"
      shell: |
        if [ -f /data/sandbox_ids.txt ]; then
          export SANDBOX_IDS=$(cat /data/sandbox_ids.txt)
          export SANDBOX_ID=$(echo "$SANDBOX_IDS" | cut -d',' -f1)
        fi
        echo "Running $QPS QPS benchmark against Ingress ($TARGET_URL) across Sandboxes ($SANDBOX_IDS)..."
        SCRIPT_PATH=$(find / -name "k6-sandbox-benchmark.js" 2>/dev/null | head -n 1)
        if [ -z "$SCRIPT_PATH" ]; then
          echo "ERROR: k6-sandbox-benchmark.js not found!"
          exit 1
        fi
        k6 run "$SCRIPT_PATH"

  after:
  - name: Cleanup Sandbox Claims (Scale to Zero)
    run:
      image: bitnami/kubectl:latest
      env:
      - name: SANDBOX_COUNT
        value: "{% raw %}{{ config.sandboxCount }}{% endraw %}"
      shell: |
        COUNT="${SANDBOX_COUNT:-1}"
        for idx in $(seq 1 "$COUNT"); do
          kubectl -n agent-sandbox delete sandboxclaim "testkube-benchmark-sandbox-${idx}" --ignore-not-found=true
        done
