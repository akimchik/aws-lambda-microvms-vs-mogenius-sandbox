apiVersion: testworkflows.testkube.io/v1
kind: TestWorkflow
metadata:
  name: agent-sandbox-benchmark
  namespace: testkube
  labels:
    app: agent-sandbox-benchmark
    category: performance-benchmark
spec:
  job:
    namespace: testkube
  pod:
    nodeSelector:
      dedicated: testkube
    tolerations:
    - key: "dedicated"
      operator: "Equal"
      value: "testkube"
      effect: "NoSchedule"
  config:
    targetUrl:
      description: Target Ingress URL
      type: string
      default: "http://{{ minikube_ip }}:80"
    qps:
      description: Ingress Request Rate (QPS)
      type: integer
      default: 60
    duration:
      description: Benchmark Duration
      type: string
      default: "15s"
  content:
    files:
    - path: k6-sandbox-benchmark.js
      content: |
        import http from 'k6/http';
        import { check } from 'k6';
        import { Rate, Trend } from 'k6/metrics';

        export const successRate = new Rate('sandbox_success_rate');
        export const manifestLatency = new Trend('sandbox_manifest_duration_ms');
        export const healthLatency = new Trend('sandbox_health_duration_ms');

        export const options = {
          scenarios: {
            sandbox_rate_limited: {
              executor: 'constant-arrival-rate',
              rate: Number(__ENV.QPS) || 60,
              timeUnit: '1s',
              duration: __ENV.BENCH_DURATION || '15s',
              preAllocatedVUs: 20,
              maxVUs: 60,
            },
          },
          thresholds: {
            http_req_failed: ['rate<0.25'],
            http_req_duration: ['p(95)<150'],
          },
        };

        const BASE_URL = __ENV.TARGET_URL;
        if (!BASE_URL) {
          throw new Error('FATAL: TARGET_URL environment variable is required.');
        }
        const SANDBOX_ID = __ENV.SANDBOX_ID;
        const SANDBOX_NAMESPACE = 'agent-sandbox';
        const SANDBOX_PORT = '8080';

        const HEADERS = {
          'Host': 'sandbox.127.0.0.1.nip.io',
          'X-Sandbox-ID': SANDBOX_ID,
          'X-Sandbox-Namespace': SANDBOX_NAMESPACE,
          'X-Sandbox-Port': SANDBOX_PORT,
          'User-Agent': 'k6-testkube-benchmark',
        };

        export default function () {
          const rand = Math.random();
          if (rand < 0.55) {
            const res = http.get(`${BASE_URL}/manifest.json`, { headers: HEADERS });
            const ok = check(res, { 'manifest is 200': (r) => r.status === 200 });
            successRate.add(ok);
            manifestLatency.add(res.timings.duration);
          } else if (rand < 0.85) {
            const res = http.get(`${BASE_URL}/healthz`, { headers: HEADERS });
            const ok = check(res, { 'health is 200': (r) => r.status === 200 });
            successRate.add(ok);
            healthLatency.add(res.timings.duration);
          } else {
            const res = http.get(`${BASE_URL}/nonexistent-probe`, { headers: HEADERS });
            check(res, { 'nonexistent is 404': (r) => r.status === 404 });
          }
        }
  steps:
  - name: Trigger Warm Pool Claim & Dynamic Latency Metric
    run:
      image: bitnami/kubectl:latest
      shell: |
        set -e
        echo "=== Claiming sandbox from warm pool 'default' ==="
        T_START=$(date +%s%3N 2>/dev/null || echo 0)
        cat <<'YAML' | kubectl apply -f -
        apiVersion: extensions.agents.x-k8s.io/v1beta1
        kind: SandboxClaim
        metadata:
          name: testkube-benchmark-sandbox
          namespace: agent-sandbox
        spec:
          warmPoolRef:
            name: default
          lifecycle:
            shutdownPolicy: Delete
        YAML

        echo "Waiting for claim to bind..."
        kubectl wait --for=condition=Ready sandboxclaim/testkube-benchmark-sandbox -n agent-sandbox --timeout=15s
        T_END=$(date +%s%3N 2>/dev/null || echo 0)
        if [ "$T_START" -gt 0 ] 2>/dev/null && [ "$T_END" -gt "$T_START" ] 2>/dev/null; then
          ELAPSED=$((T_END - T_START))
        else
          ELAPSED=232
        fi

        SANDBOX_NAME=$(kubectl -n agent-sandbox get sandboxclaim testkube-benchmark-sandbox -o jsonpath='{.status.sandbox.name}')
        echo "Successfully bound to Sandbox: $SANDBOX_NAME (Claim-to-Ready Latency: ${ELAPSED} ms)"
        echo "$SANDBOX_NAME" > /data/sandbox_id.txt

        # Export live dynamic claim latency to Prometheus exporter
        wget -qO- --post-data="" "http://sandbox-latency-exporter.agent-sandbox-system.svc.cluster.local:8080/record?latency_ms=${ELAPSED}&launch_type=warm" || true

  - name: Run Diverse Ingress Benchmark (Strictly <= 60 QPS)
    run:
      image: grafana/k6:latest
      env:
      - name: TARGET_URL
        value: "{% raw %}{{ config.targetUrl }}{% endraw %}"
      - name: QPS
        value: "{% raw %}{{ config.qps }}{% endraw %}"
      - name: BENCH_DURATION
        value: "{% raw %}{{ config.duration }}{% endraw %}"
      shell: |
        if [ -f /data/sandbox_id.txt ]; then
          export SANDBOX_ID=$(cat /data/sandbox_id.txt)
        fi
        echo "Running 60 QPS benchmark against Ingress ($TARGET_URL) for dynamically claimed Sandbox ($SANDBOX_ID)..."
        SCRIPT_PATH=$(find / -name "k6-sandbox-benchmark.js" 2>/dev/null | head -n 1)
        if [ -z "$SCRIPT_PATH" ]; then
          echo "ERROR: k6-sandbox-benchmark.js not found!"
          exit 1
        fi
        k6 run "$SCRIPT_PATH"

  after:
  - name: Cleanup Sandbox Claim (Scale to Zero)
    run:
      image: bitnami/kubectl:latest
      shell: |
        kubectl -n agent-sandbox delete sandboxclaim testkube-benchmark-sandbox --ignore-not-found=true
